{
  "name": "chat-session-be",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc",
    "build:ts": "tsc",
    "start": "node dist/main.js",
    "pm2:start": "npm run build:ts && pm2.cmd start ecosystem.config.cjs",
    "pm2:restart": "npm run build:ts && pm2.cmd restart chat-session-be --update-env",
    "pm2:stop": "pm2.cmd stop chat-session-be",
    "pm2:delete": "pm2.cmd delete chat-session-be",
    "pm2:logs": "pm2.cmd logs chat-session-be",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "db:bootstrap": "prisma db execute --schema prisma/schema.prisma --file prisma/bootstrap.sql",
    "db:init:tables": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260520000000_init/migration.sql",
    "db:migrate:admin": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260520000100_multi_room_admin/migration.sql",
    "db:migrate:accounts": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260520000200_accounts/migration.sql",
    "db:migrate:chat-account": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260520000300_chat_account_table/migration.sql",
    "db:migrate:profile-attachments": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260520000400_profile_attachments/migration.sql",
    "db:migrate:read-receipts": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260520000500_read_receipts/migration.sql",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
